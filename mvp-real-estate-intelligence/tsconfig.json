{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "typeRoots": ["src/types", "node_modules/@types"],
    "noEmit": true
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"]
}
